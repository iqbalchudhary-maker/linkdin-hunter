generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id           String   @id @default(cuid())
  companyName  String
  websiteUrl   String?
  phoneNumber  String?  // Nayi field Phone ke liye
  linkedinUrl  String?  // LinkedIn profile ke liye
  industry     String
  country      String
  aiAnalysis   String?  @db.Text
  status       String   @default("NEW") // Status: NEW ya SENT
  createdAt    DateTime @default(now())
}